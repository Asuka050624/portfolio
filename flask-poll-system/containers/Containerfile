# 使用Python 3.12 slim版本作为基础镜像
FROM python:3.12-slim

# 设置工作目录为/app
WORKDIR /app

# 复制依赖文件到容器中
COPY requirements.txt .
# 安装Python依赖，不使用缓存以减小镜像大小
RUN pip install --no-cache-dir -r requirements.txt

# 复制应用主文件
COPY app.py .
# 复制模板文件夹
COPY templates/ templates/

# 暴露5000端口供外部访问
EXPOSE 5000

# 启动Flask应用，监听所有网络接口
CMD ["flask", "run", "--host=0.0.0.0"]